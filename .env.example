PORT=8765
ADMIN_USER=admin
ADMIN_PASS=cambiar-esta-clave
SESSION_SECRET=generar-un-valor-random-largo

# Descomentar solo para pruebas: acepta cualquier usuario/contraseña en /admin.html
# ADMIN_OPEN_LOGIN=true

# Descomentar solo para pruebas: el local figura Abierto siempre, ignora los horarios
# FORCE_OPEN=true

# Neon (PostgreSQL) — base de datos persistente. Obtener desde https://console.neon.tech
DATABASE_URL=postgresql://usuario:contraseña@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
